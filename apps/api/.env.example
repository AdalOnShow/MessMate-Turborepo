# API Environment Variables

# JWT Secrets (generate random 64-character hex strings)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Database URL (should match root .env)
DATABASE_URL=

# CORS
CORS_ORIGIN=http://localhost:3000

# Server
PORT=4000

# Security
BCRYPT_SALT_ROUNDS=10

# Environment
NODE_ENV=development
