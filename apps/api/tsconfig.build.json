{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // Keep the incremental cache inside dist/: nest's deleteOutDir wipes dist,
    // and a surviving cache makes tsc think nothing changed and emit no files.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*spec.ts"]
}
